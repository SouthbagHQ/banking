{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "southbag-online-banking",
  "account_id": "1044a3131c99356eba069325d3be3788",
  "main": "worker.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "banking.southbag.cc", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "southbag-online-banking",
      "database_id": "43a4e76a-b997-403a-ad4e-6bbabc008469"
    }
  ],
  // `wrangler secret put IDENTITY_INTERNAL_SECRET` with this service's entry from Identity's
  // INTERNAL_API_SECRETS (key "southbag-online-banking"): loan-default freezes are reported to
  // Identity's internal API (identity.js). Without it, reports stay queued in
  // identity_freeze_outbox and the daily cron keeps retrying.
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
